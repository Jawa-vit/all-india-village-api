generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  states    State[]
}

model State {
  id        Int        @id @default(autoincrement())
  name      String
  code      String
  countryId Int
  createdAt DateTime   @default(now())
  districts District[]
  country   Country    @relation(fields: [countryId], references: [id])
}

model District {
  id           Int           @id @default(autoincrement())
  name         String
  stateId      Int
  createdAt    DateTime      @default(now())
  code         String
  state        State         @relation(fields: [stateId], references: [id])
  subDistricts SubDistrict[]
}

model SubDistrict {
  id         Int      @id @default(autoincrement())
  code       String
  name       String
  districtId Int
  createdAt  DateTime @default(now())

  district District @relation(fields: [districtId], references: [id])

  villages Village[]
}

model Village {
  id            Int      @id @default(autoincrement())
  code          String
  name          String
  subDistrictId Int
  createdAt     DateTime @default(now())

  subDistrict SubDistrict @relation(fields: [subDistrictId], references: [id])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())
}
